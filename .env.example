# Welche Gliederung (Ordner unter instanzen/); Standard dv-trier.
KLUFT_INSTANZ=dv-trier

APP_NAME="DPSG Diözesanverband Trier"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Argon2id, s. Pflichtenheft 5.2 (betrifft nur den lokalen
# Notfall-Super-Admin – Entra-Nutzer haben kein lokales Passwort).
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Produktion/Test: MySQL/MariaDB (s. Pflichtenheft 3.1/4.5). Lokal per
# Default SQLite für eine schnelle, abhängigkeitsfreie Entwicklungsumgebung.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=dpsg_dv_trier
# DB_USERNAME=
# DB_PASSWORD=

# 8 Stunden, s. Pflichtenheft 5.1 „Session-Lebensdauer max. 8 h“.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Kein Redis/Supervisor nötig (Pflichtenheft 3.1) – Queue läuft per Cron
# (`queue:work --stop-when-empty`), s. 4.5 Punkt 7.
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

# Brevo SMTP-Relay für Transaktionsmails (Pflichtenheft 6.10). Der
# Georgsbote-Newsletter selbst läuft separat über die Brevo-API, nicht
# über diesen Mailer.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="events@dpsg-trier.de"
MAIL_FROM_NAME="${APP_NAME}"
# Testumgebung: alle ausgehenden Mails hierhin umleiten (F-MAIL-06).
# In der Produktion leer lassen!
MAIL_TEST_REDIRECT_TO=

# Microsoft Entra ID (M365) – Redaktions-Login, s. Pflichtenheft 5.1/5.6.
# Je Umgebung (test/prod) eine eigene App-Registrierung mit eigener
# Redirect-URI.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
ENTRA_REDIRECT_URI="${APP_URL}/auth/entra/callback"

# Brevo (Newsletter-Double-Opt-In + API), s. Pflichtenheft 6.6.
BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
BREVO_DOI_REDIRECT_URL="${APP_URL}/georgsbote/danke"

# Instagram (Pflichtenheft 6.4): Token wird im Backend unter
# „Integrationen“ eingetragen, nicht hier. Nur die API-Version ist
# einstellbar.
# INSTAGRAM_GRAPH_VERSION=v23.0

VITE_APP_NAME="${APP_NAME}"

# Nextcloud-Kalender: erlaubte Hosts für ICS-Freigabelinks (kommagetrennt), F-CAL-07
NEXTCLOUD_ALLOWED_HOSTS=

# Push-Nachrichten (ntfy): optional eigener Server statt ntfy.sh und Zugangstoken
NTFY_SERVER=
NTFY_TOKEN=

# WhatsApp-Newsletter (docs/whatsapp_newsletter.md). Zugangsdaten werden im
# Backend gepflegt; hier nur Verhalten. Testmodus ist automatisch an, wenn
# MAIL_TEST_REDIRECT_TO gesetzt ist.
WHATSAPP_MODE=off
WHATSAPP_CHANNEL_URL=
WHATSAPP_TEST_ALLOWLIST=
WHATSAPP_FORM_DOI=false
WHATSAPP_FOUR_EYES=true
