# Secrets des GitHub-Environments. Diese Datei NUR außerhalb des
# Repositories ausfüllen und nie in einen Chat kopieren.
# Leere Zeilen weglassen; was fehlt, wird nicht gesetzt.

# Server (Pflicht). Zielordner: absoluter Pfad, DocumentRoot = <pfad>/public
SSH_HOST=
SSH_PORT=22
SSH_USERNAME=
SSH_TARGET_DIR=
# Den privaten Schlüssel als Datei ssh_key daneben legen (wird SSH_PRIVATE_KEY).

# Datenbank (MariaDB, eigene Datenbank je Instanz; ohne diese Zeilen SQLite)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Mail über Brevo – am besten das eigene Brevo-Konto des Stamms (Roden hat eins),
# dort die Absenderdomain bestätigen. In der Testphase gehen Mails nur an die Testadresse und
# an Adressen auf der Freigabeliste (z. B. das Postfach des ersten Zugangs).
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
MAIL_TEST_REDIRECT_TO=
# Roden: mindestens kontakt@dpsg-roden.de (erster Zugang, bekommt den Anmeldecode)
MAIL_TEST_ALLOWLIST=

# Backups (Passwort zusätzlich offline aufbewahren)
BACKUP_PASSWORD=

# Lageranmeldungen mit NaMi-Abgleich (persönliche Anmeldung, nichts gespeichert)
MITGLIEDER_DRIVER=nami

# Anmeldung mit Microsoft 365 (eigener Mandant des Stamms). Am einfachsten
# mit scripts/entra-app-anlegen.sh – das trägt die drei Werte hier ein.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
