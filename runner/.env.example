# Kopieren nach .env (chmod 600), nie ins Repository.
GITHUB_REPO=son1x/kluft
# Fine-grained Personal Access Token: nur Repository son1x/kluft,
# Recht „Administration: Read and write“ (damit holt der Runner sich seinen
# Anmelde-Token). Ablaufdatum setzen und rechtzeitig erneuern.
GITHUB_PAT=
RUNNER_NAME=nas
RUNNER_LABELS=nas
# Gruppe des Docker-Sockets: stat -c %g /var/run/docker.sock
DOCKER_GID=999
