# Variablen des GitHub-Environments (sichtbar, keine Geheimnisse).
# Kopie AUSSERHALB des Repositories anlegen und ausfüllen, dann:
#   scripts/environment-anlegen.sh <instanz> <ordner>
# Beispielwerte für die Instanz roden.
APP_URL=https://www.dpsg-roden.de
MAIL_FROM_ADDRESS=website@dpsg-roden.de
MAIL_FROM_NAME=DPSG Roden
APP_ENV=production
PHP_BIN=/usr/bin/php
# Erst setzen, wenn die Seite läuft (Monitoring und Web-Checks):
# MONITOR_URL=https://www.dpsg-roden.de
