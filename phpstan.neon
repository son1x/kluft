# Statische Analyse mit Larastan (Pflichtenheft 10.5). Läuft in GitHub
# Actions (Workflow „Qualität“).
includes:
    - vendor/larastan/larastan/extension.neon
    # Bestand vom 3.10.2026 (überwiegend Datumsfelder, die Larastan als
    # Text liest). Neuer Code muss ohne neue Meldungen auskommen.
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app
        - config
        - routes
        - database
        - instanzen
    tmpDir: storage/framework/cache/phpstan
    # Die Baseline darf schrumpfen, wenn Bestand behoben wird.
    reportUnmatchedIgnoredErrors: false
